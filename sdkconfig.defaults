# esp32libfun default configuration
# Common settings for all targets - do NOT set CONFIG_IDF_TARGET here.
# Use sdkconfig.defaults.<target> for target-specific overrides.

# esp32libfun modules
CONFIG_ESP32LIBFUN_SERIAL=y
CONFIG_ESP32LIBFUN_AT=y
CONFIG_ESP32LIBFUN_AT_MAX_CMDS=48
CONFIG_ESP32LIBFUN_DELAY=y
CONFIG_ESP32LIBFUN_GPIO=y
CONFIG_ESP32LIBFUN_LEDC=y
CONFIG_ESP32LIBFUN_I2C=y
CONFIG_ESP32LIBFUN_PCNT=y
CONFIG_ESP32LIBFUN_SPI=y
CONFIG_ESP32LIBFUN_MCPWM=y
CONFIG_ESP32LIBFUN_RMT=y
CONFIG_ESP32LIBFUN_ADC=y
CONFIG_ESP32LIBFUN_GPTIMER=y
CONFIG_ESP32LIBFUN_TWAI=y
